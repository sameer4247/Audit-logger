model AuditLog {
    id        String     @id @default(uuid())
    timestamp DateTime   @default(now())
    entity    String // 'Book', 'User'
    entityId  String
    action    ActionType
    actorId   String?
    actor     User?      @relation("actor", fields: [actorId], references: [id])

    diff      String // JSON Patch ops
    requestId String

    // Relations
    @@index([entity])
    @@index([entity, entityId])
    @@index([actorId])
    @@index([action])
    @@index([timestamp])
}

enum ActionType {
    create
    update
    delete
    restore
}
